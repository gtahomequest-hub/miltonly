    { "op": "type", "selector": "#capture input[type=\"email\"]", "value": "gtahomequest+ml013-street-alert@gmail.com" },
    { "op": "scroll", "selector": "#capture button[type=\"submit\"]" },
    { "op": "tap", "selector": "#capture button[type=\"submit\"]" }
  ],
  "success": "You are watching",
  "settleMs": 5000
}
