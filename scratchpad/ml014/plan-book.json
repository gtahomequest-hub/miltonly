    { "op": "type", "selector": "form input[name=\"name\"]", "value": "ML014 test booking" },
    { "op": "type", "selector": "form input[name=\"phone\"]", "value": "6470000014" },
    { "op": "type", "selector": "form input[name=\"email\"]", "value": "gtahomequest+ml014-book@gmail.com" },
    { "op": "type", "selector": "form textarea[name=\"message\"]", "value": "ML-014 test submission from the booking page, delete me" },
    { "op": "tap", "text": "Request a showing" }
  ],
  "success": "Request received",
  "settleMs": 6000
